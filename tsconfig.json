{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext"
    ],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "newLine": "LF",
    "declaration": true,
    "declarationDir": "dist",
    "rootDir": ".",
    "baseUrl": "./"
  },
  "include": [
    "webpack.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
